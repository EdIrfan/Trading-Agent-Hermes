# Hermes — DEV environment secrets. Copy this to `.env.dev` and fill in.
# `.env.dev` is gitignored and must never be committed.

# ---- LLM (the brain) ----
# Google Gemini FREE-tier key. Get one (no billing needed) at:
#   https://aistudio.google.com/apikey
# Paste it after the = sign, no quotes. Required to run the real brain;
# the MockBrain / demo need no key.
GOOGLE_API_KEY=

# (Other providers — only if you switch llm_provider in config/dev.yaml.)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Exchange (live market data) ----
# DEV reads LIVE prices but never places real orders (PaperBroker). Public market
# data is keyless, so these stay blank in DEV. Do NOT put a trade-enabled key here.
BINANCE_API_KEY=
BINANCE_API_SECRET=
