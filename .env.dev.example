# Hermes — DEV environment secrets. Copy this to `.env.dev` and fill in.
# `.env.dev` is gitignored and must never be committed.

# ---- LLM (the brain) ----
# Anthropic API key (paid, pay-per-token — SEPARATE from a Claude Pro/Code
# subscription). Create at https://console.anthropic.com and add billing credit.
# Required to run the real brain; the MockBrain needs no key.
ANTHROPIC_API_KEY=

# ---- Exchange (live market data) ----
# DEV reads LIVE Binance prices but never places real orders (PaperBroker).
# Public market data is keyless, so these can stay blank in DEV. Leave them
# empty unless you hit rate limits and want authenticated read access.
# DO NOT put a trade-enabled key here — DEV must not be able to touch real funds.
BINANCE_API_KEY=
BINANCE_API_SECRET=
